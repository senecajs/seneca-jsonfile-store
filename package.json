{
  "name": "@seneca/jsonfile-store",
  "version": "2.0.0",
  "description": "Seneca data store plugin that uses plain JSON files",
  "main": "jsonfile-store.js",
  "license": "MIT",
  "author": "Richard Rodger (http://richardrodger.com/)",
  "contributors": [
    "Peter Elger (http://peterelger.com)",
    "Matteo Collina (http://www.matteocollina.com)",
    "Michele Capra (https://twitter.com/piccoloaiutante)",
    "Dean McDonnell (http://mcdonnelldean.me)"
  ],
  "scripts": {
    "test": "lab -v -P test -t 40",
    "coverage": "lab -v -P test -t 40 -r html > docs/coverage.html",
    "prettier": "prettier --write --no-semi --single-quote *.js test/*.js",
    "clean-npm": "rm -rf node_modules package-lock.json",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"`; echo TAG: v$REPO_VERSION; git commit -a -m v$REPO_VERSION; git tag v$REPO_VERSION; git push --tags;",
    "repo-publish": "npm run repo-tag; npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-jsonfile-store.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "seneca",
    "plugin",
    "store",
    "json",
    "file"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "CHANGES.md",
    "jsonfile-store.js"
  ],
  "dependencies": {
    "eraro": "^3.1.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@hapi/code": "^9.0.3",
    "@hapi/lab": "^26.0.1",
    "@seneca/entity": "^29.0.0",
    "@seneca/store-test": "^7.0.0",
    "seneca": "^4.0.0"
  },
  "peerDependencies": {
    "@seneca/entity": "^29.0.0",
    "seneca": "^4.0.0"
  }
}
